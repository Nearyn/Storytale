<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<!-- Ligne "liste de choix" des options de Storytale : "<  valeur  >", la valeur ouvre la
	     fenetre de choix de Storytale (jamais la liste deroulante du jeu, voir Options_Native.lua). -->
	<Frame name="StorytaleSettingsChoiceTemplate" inherits="SettingsListElementTemplate" mixin="StorytaleSettingsChoiceMixin" virtual="true">
		<Size x="280" y="26"/>
		<Frames>
			<Button parentKey="Prev" motionScriptsWhileDisabled="true">
				<Size x="22" y="22"/>
				<Anchors>
					<Anchor point="LEFT" relativePoint="CENTER" x="-48" y="0"/>
				</Anchors>
				<NormalTexture file="Interface\Buttons\UI-SpellbookIcon-PrevPage-Up"/>
				<PushedTexture file="Interface\Buttons\UI-SpellbookIcon-PrevPage-Down"/>
				<DisabledTexture file="Interface\Buttons\UI-SpellbookIcon-PrevPage-Disabled"/>
				<HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
			</Button>
			<Button parentKey="Value" inherits="UIPanelButtonTemplate" motionScriptsWhileDisabled="true">
				<Size x="176" y="22"/>
				<Anchors>
					<Anchor point="LEFT" relativeKey="$parent.Prev" relativePoint="RIGHT" x="2" y="0"/>
				</Anchors>
			</Button>
			<Button parentKey="Next" motionScriptsWhileDisabled="true">
				<Size x="22" y="22"/>
				<Anchors>
					<Anchor point="LEFT" relativeKey="$parent.Value" relativePoint="RIGHT" x="2" y="0"/>
				</Anchors>
				<NormalTexture file="Interface\Buttons\UI-SpellbookIcon-NextPage-Up"/>
				<PushedTexture file="Interface\Buttons\UI-SpellbookIcon-NextPage-Down"/>
				<DisabledTexture file="Interface\Buttons\UI-SpellbookIcon-NextPage-Disabled"/>
				<HighlightTexture file="Interface\Buttons\UI-Common-MouseHilight" alphaMode="ADD"/>
			</Button>
		</Frames>
		<Scripts>
			<OnLoad method="OnLoad"/>
		</Scripts>
	</Frame>
</Ui>
